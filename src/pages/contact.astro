---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — CopperTrace" description="Contact CopperTrace about engineering projects, collaboration or technical work.">
  <article class="article contact-page">
    <div class="article-meta">Contact</div>
    <h1>Get in touch.</h1>
    <p class="lead">
      Questions about a project, engineering work or collaboration? Send a message below.
      The contact address is not published on this site.
    </p>

    <form class="contact-form" id="contact-form">
      <div class="contact-row">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" maxlength="100" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" maxlength="200" required />
        </label>
      </div>
      <label>
        <span>Message</span>
        <textarea name="message" rows="7" maxlength="5000" required></textarea>
      </label>

      <div class="contact-honeypot" aria-hidden="true">
        <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button class="button primary" type="submit" disabled>Send message</button>
      <p class="form-status" role="status">
        Message delivery is being configured. The form will be enabled once the private mail route is connected.
      </p>
    </form>

    <div class="callout">
      No email address, phone number or private location is exposed in the public page source.
    </div>
  </article>
</Layout>
