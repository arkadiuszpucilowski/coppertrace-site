---
import Layout from '../../layouts/Layout.astro';
---
<Layout lang="pl" title="Kontakt — CopperTrace" description="Kontakt z CopperTrace w sprawie projektów, współpracy lub pracy inżynierskiej.">
<article class="article contact-page"><div class="article-meta">Kontakt</div><h1>Napisz do mnie.</h1><p class="lead">Masz pytanie o projekt, współpracę lub pracę inżynierską? Skorzystaj z formularza. Adres e-mail nie jest publikowany na stronie.</p>
<form class="contact-form" id="contact-form">
<div class="contact-row"><label><span>Imię</span><input type="text" name="name" autocomplete="name" maxlength="100" required/></label><label><span>Email</span><input type="email" name="email" autocomplete="email" maxlength="200" required/></label></div>
<label><span>Wiadomość</span><textarea name="message" rows="7" maxlength="5000" required></textarea></label>
<div class="contact-honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"/></label></div>
<div class="cf-turnstile" data-sitekey="0x4AAAAAAE_A52SGD72RV0Vs" data-theme="dark"></div>
<button class="button primary" type="submit">Wyślij wiadomość</button><p class="form-status" role="status">Formularz jest chroniony przez Cloudflare Turnstile.</p>
</form><div class="callout">Adres e-mail, numer telefonu ani prywatna lokalizacja nie są ujawniane w publicznym kodzie strony.</div></article>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
(()=>{const f=document.getElementById('contact-form');if(!f)return;const b=f.querySelector('button');const s=f.querySelector('.form-status');f.addEventListener('submit',async e=>{e.preventDefault();if(!f.reportValidity())return;const d=Object.fromEntries(new FormData(f).entries());if(!d['cf-turnstile-response']){s.textContent="Sprawdzenie bezpieczeństwa nie powiodło się. Spróbuj ponownie.";return;}b.disabled=true;s.textContent="Wysyłanie…";try{const r=await fetch('/api/contact',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)});const j=await r.json().catch(()=>({}));if(!r.ok)throw new Error(j.error||'failed');f.reset();if(window.turnstile)window.turnstile.reset();s.textContent="Dziękuję — wiadomość została wysłana.";}catch(err){s.textContent=err.message||"Nie udało się wysłać wiadomości. Spróbuj ponownie później.";if(window.turnstile)window.turnstile.reset();}finally{b.disabled=false;}});})();
</script></Layout>