---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="wrap hero">
    <div>
      <div class="kicker">Electronics · Embedded · Reverse Engineering · RF</div>
      <h1>Built on the bench.</h1>
      <p class="lead">
        Practical engineering projects, measurements and experiments — from power electronics
        and firmware analysis to RF systems, embedded control and automated test equipment.
      </p>
    </div>
    <aside class="hero-aside">
      <strong>Current work</strong>
      Reverse engineering compact lab hardware and developing modular RF sensing infrastructure.
    </aside>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="kicker">Selected work</div>
          <h2>Projects</h2>
        </div>
        <p>
          Projects are documented as engineering notebooks: assumptions, measurements,
          failures, evidence and the final implementation.
        </p>
      </div>

      <div class="grid">
        <a class="card featured" href="/projects/toolkitrc-p200/">
          <div class="meta">Project 001 · In progress</div>
          <h3>ToolkitRC P200 smart power supply</h3>
          <p>
            Firmware analysis, SWD, control-bus sniffing and a plan to convert three compact
            supplies into a remotely controlled three-channel lab PSU.
          </p>
          <div class="tags">
            <span class="tag">GD32F103</span><span class="tag">SWD</span><span class="tag">I²C</span>
            <span class="tag">USB-PD</span><span class="tag">RP2350</span>
          </div>
        </a>

        <a class="card small" href="/projects/sky-serpent/">
          <div class="meta">Project 002 · Active R&amp;D</div>
          <h3>Sky Serpent</h3>
          <p>
            Modular RF sensing research combining embedded receiver nodes, SDR hardware,
            Ethernet infrastructure and automated signal analysis.
          </p>
          <div class="tags">
            <span class="tag">RF</span><span class="tag">SDR</span><span class="tag">Embedded</span>
            <span class="tag">Linux</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
